{
  "name": "poof-sounds",
  "version": "5.7.1-2",
  "private": true,
  "description": "build scripts for poof sounds",
  "type": "module",
  "scripts": {
    "build": "node build_scripts/build.ts",
    "clean": "node build_scripts/clean.ts",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prebuild": "npm run validate",
    "typecheck": "tsc",
    "preversion": "npm run validate",
    "validate": "node build_scripts/validate.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "jimp": "^1.6.0",
    "semver": "^7.5.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/ffprobe": "^1.1.8",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@12.0.2"
}
